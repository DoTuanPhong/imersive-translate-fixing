[
  {
    "id": "hianime",
    "matches": [
      "megaplay.buzz",
      "kwik.cx",
      "kwik.si",
      "kwik.sh",
      "anisuge.tv",
      "vidstream.pro",
      "1anime.site",
      "hianime.to"
    ],
    "isNativeVideo": true,
    "videoSelector": "video",
    "injectBy": "track",
    "autoEnabledBilingualSubtitles": true,
    "selectors": {
      "wrapperSelector": ".artplayer-app, .jwplayer, .jw-wrapper, #player, .video-content",
      "videoIconSelector": ".jw-controlbar-right-group, .art-controls-right, .jw-controls-right, .plyr__controls",
      "controlsSelector": ".jw-controlbar, .art-controls, .jw-controls, .plyr__controls",
      "subtitlesContainer": ".jw-captions, .art-subtitles, .jw-subtitles, .plyr__captions, .jw-text-track-container"
    },
    "quickButtonRule": {
      "appendSelector": ".jw-controlbar-right-group, .art-controls-right, .jw-controls-right, .plyr__controls",
      "insertBeforeSelector": ".jw-icon-fullscreen, .jw-icon-settings, .art-control-setting, .art-control-fullscreen"
    }
  }
]
